                <span class="item-price">from R400</span>
            </div>
        </div>

        <!-- Nails & Beauty -->
        <div class="menu-category">
            <div class="category-title">Nails & Aesthetics</div>
            <div class="menu-item">
                <span class="item-name">Gel Overlay (Hands or Feet)</span>
