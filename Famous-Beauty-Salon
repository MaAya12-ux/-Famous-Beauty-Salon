            </div>
            <div class="info-box">
                <h3>Our Location</h3>
                <p>Berea, Durban</p>
                <p>South Africa</p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Famous Beauty Salon. All Rights Reserved. Designed to grow your business.</p>
    </footer>

</body>
</html>
