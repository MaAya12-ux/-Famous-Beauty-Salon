                <span class="item-price">R280</span>
            </div>
            <div class="menu-item">
                <span class="item-name">Eyebrow Wax & Tint</span>
                <span class="item-price">R120</span>
            </div>
        </div>
    </section>

    <section class="info-section">
        <div class="info-grid">
            <div class="info-box">
                <h3>Opening Hours</h3>
                <p>Mon - Sat: 08:30 - 17:30</p>
